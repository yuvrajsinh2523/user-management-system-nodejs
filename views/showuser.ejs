<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User's Data</title>
    <style>
        th,td,tr{
            border:1px solid black;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th>User ID</th>
            <th>User Name</th>
            <th>User Email-ID</th>
        </tr>
        
        <%for(users of user){%>
            <tr>
            <td><%=users.id%></td>
            <td><%=users.name%></td>
            <td><%=users.email%></td>
            <td><form action="/user/<%=user.id%>/edit" method="GET">
                <button>Edit user</button>
            </form></td>
        </tr>
           <% }%>
    </table>
</body>
</html>
